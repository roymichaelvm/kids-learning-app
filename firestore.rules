// Roy's Learning Hub — Firestore security rules for multi-family use.
//
// HOW TO APPLY: Firebase Console → Firestore Database → Rules → paste this
// whole file → Publish. Until these rules are published, family isolation
// is enforced by the app only (any signed-in account could in theory read
// other families' documents with a hand-crafted request). After publishing,
// the database itself enforces it.
//
// Model: every parent account (Firebase Auth UID) is a family. Learner
// profiles carry a familyId field equal to the owning parent's UID.
// The two founding accounts additionally own the shared content (question
// bank + language packs) and can read all profiles (support/legacy data).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFounder() {
      return signedIn() && request.auth.uid in [
        'PhoXVNDqH0SsQhlejoY7ko3zvee2',
        'yc14OBS0vKWh2tjfTf6H3ez41P23'
      ];
    }

    function ownsProfile(profileId) {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(profileId)).data.familyId == request.auth.uid;
    }

    // ---- Learner profiles + their daily activity subcollection
    match /profiles/{profileId} {
      allow read: if isFounder()
        || (signedIn() && resource.data.familyId == request.auth.uid);
      allow create: if isFounder()
        || (signedIn() && request.resource.data.familyId == request.auth.uid);
      allow update, delete: if isFounder()
        || (signedIn() && resource.data.familyId == request.auth.uid
            && request.resource.data.familyId == request.auth.uid);

      match /days/{date} {
        allow read, write: if isFounder() || ownsProfile(profileId);
      }
    }

    // ---- App state: global meta is shared content bookkeeping (question
    // bank + language pack versions). Per-family settings live in
    // app_state/family_<uid> and belong to that family alone.
    match /app_state/meta {
      allow read: if signedIn();
      allow write: if isFounder();
    }
    match /app_state/{docId} {
      allow read, write: if isFounder()
        || (signedIn() && docId == 'family_' + request.auth.uid);
    }

    // ---- Shared learning content (same for every family)
    match /question_chunks/{chunkId} {
      allow read: if signedIn();
      allow write: if isFounder();
    }
    match /language_packs/{packId} {
      allow read: if signedIn();
      allow write: if isFounder();
    }
  }
}
